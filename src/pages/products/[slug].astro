---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<BaseLayout title={`${product.name} | Trade Avata`}>
  <section class="page">
    <div class="shell">
      <div class="grid grid-2">

        <div>
          <div
            class="mock"
            style="height:360px;border-radius:22px"
          ></div>
        </div>

        <div>
          <span class="eyebrow">
            {product.platform}
          </span>

          <h1
            class="page-title"
            style="font-size:52px"
          >
            {product.name}
          </h1>

          <p class="lead">
            {product.desc}
          </p>

          <p>
            <b>Rating:</b> ★ {product.rating}
          </p>

          <p>
            <b>Access:</b> {product.price}
          </p>

          <div class="actions">
            <button
              class="button"
              data-get
            >
              Get Indicator
            </button>

            <a
              class="pill"
              style="color:var(--text)"
              href={`${base}contact/`}
            >
              Ask a Question
            </a>
          </div>

          <div
            class="notice"
            data-status
            style="margin-top:18px"
          >
            Sign in to keep this product in your member library and access its downloads.
          </div>
        </div>

      </div>

      <div
        class="section"
        style="padding-bottom:0"
      >
        <div class="grid grid-3">

          <article class="card">
            <div class="card-body">
              <h3>What it does</h3>

              <p>
                Provides a focused visual layer for the conditions described above without replacing the trader's decision process.
              </p>
            </div>
          </article>

          <article class="card">
            <div class="card-body">
              <h3>Platform</h3>

              <p>
                {product.platform}. Product downloads and version history will appear in the member dashboard.
              </p>
            </div>
          </article>

          <article class="card">
            <div class="card-body">
              <h3>Support</h3>

              <p>
                Setup documentation, updates and support access are attached to the product record.
              </p>
            </div>
          </article>

        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document
      .querySelector('[data-get]')
      ?.addEventListener('click', () => {
        localStorage.setItem(
          'ta-last-product',
          document.title
        );

        const status =
          document.querySelector(
            '[data-status]'
          );

        if (status) {
          status.textContent =
            'Saved to your member preview.';
        }
      });
  </script>
</BaseLayout>
