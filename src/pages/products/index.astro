---
import BaseLayout from '../../layouts/BaseLayout.astro';import {products} from '../../data/site.js';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<BaseLayout title="Indicators | Trade Avata"><section class="page"><div class="shell"><span class="eyebrow">INDICATOR STORE</span><h1 class="page-title">Trading indicators, clearly explained.</h1><p class="lead">Browse tools by platform, see what each product is designed to do, and open the detail page before downloading or purchasing.</p><div class="actions" style="margin-bottom:25px"><button class="pill" data-filter="all">All</button><button class="pill" data-filter="MT4">MT4</button><button class="pill" data-filter="MT5">MT5</button><button class="pill" data-filter="cTrader">cTrader</button><button class="pill" data-filter="TradingView">TradingView</button></div><div class="grid grid-4" data-grid>{products.map(p=><article class="card" data-platform={p.platform}><div class="mock"></div><div class="card-body"><span class="badge">{p.platform}</span><h3>{p.name}</h3><p>{p.desc}</p><p><b>★ {p.rating}</b> · {p.price}</p><a class="button" href={`${b}products/${p.slug}/`}>View Details</a></div></article>)}</div></div></section><script is:inline>document.querySelectorAll('[data-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-platform]').forEach(card=>card.hidden=btn.dataset.filter!=='all'&&card.dataset.platform!==btn.dataset.filter)}));</script></BaseLayout>
