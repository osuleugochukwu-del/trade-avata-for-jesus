---
import BaseLayout from '../layouts/BaseLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<BaseLayout title="Tools | Trade Avata"><section class="page"><div class="shell"><span class="eyebrow">TOOLS</span><h1 class="page-title">Two focused trading workspaces.</h1><p class="lead">Trade Avata keeps the tools area focused on advanced Analytics and the Trading Journal.</p><div class="grid grid-2" style="margin-top:28px"><article class="card"><div class="mock"></div><div class="card-body"><h3>Advanced Analytics</h3><p>Performance, risk, comparisons, reports, bookkeeping and AI-assisted evidence review.</p><a class="button" href={`${b}analytics/`}>Open Analytics</a></div></article><article class="card"><div class="mock"></div><div class="card-body"><h3>Advanced Journal</h3><p>Notion-style trade entry plus deep review, behavior, strategy and investigation tools.</p><a class="button" href={`${b}journal/`}>Open Journal</a></div></article></div></div></section></BaseLayout>
