---
import AppLayout from '../../layouts/AppLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const nav=[{label:'Overview',icon:'▥',href:'#overview',active:true},{label:'Visitors & Traffic',icon:'↗',href:'#traffic'},{label:'Users',icon:'○',href:'#users'},{label:'Members',icon:'◉',href:'#users'},{label:'Analytics Accounts',icon:'▤',href:'#analytics'},{label:'Journal Oversight',icon:'▣',href:'#journal'},{label:'Products / Indicators',icon:'◇',href:'#products'},{label:'Courses',icon:'▧',href:'#courses'},{label:'Orders / Sales',icon:'▱',href:'#sales'},{label:'Support Inbox',icon:'✉',href:'#support'},{label:'Email Center',icon:'✉',href:'#email'},{label:'Homepage / Banners',icon:'▦',href:'#content'},{label:'Content / Pages',icon:'≡',href:'#content'},{label:'Copy Trading',icon:'⇄',href:'#copy'},{label:'Reports / Exports',icon:'⇩',href:'#reports'},{label:'Payments / Integrations',icon:'⛓',href:'#integrations'},{label:'Roles & Permissions',icon:'♙',href:'#roles'},{label:'Activity Logs',icon:'◷',href:'#logs'},{label:'Settings',icon:'⚙',href:'#settings'}];
---
<AppLayout title="Admin Control Center | Trade Avata" section="Admin Control Center" nav={nav} profile="Admin · Super Admin"><Fragment slot="top-left"><input class="search-wide" placeholder="Search users, orders, tickets, pages..." style="width:min(520px,45vw)"></Fragment><Fragment slot="top-right"><span class="control good">● System Online</span><button class="control">🔔 3</button><button class="control primary" data-quick>⚡ Quick Actions</button></Fragment>
<div class="page-compact-head" id="overview"><div><h1>Admin Control Center</h1><p>Monitor and manage the Trade Avata platform from one place.</p></div><select class="control"><option>Last 30 days</option><option>Last 7 days</option><option>This year</option></select></div>
<div class="dashboard-grid kpi-grid"><article class="kpi"><span>Total Users</span><strong>24,532</strong><small class="good">+12%</small></article><article class="kpi"><span>Active Members</span><strong>8,421</strong><small class="good">+8%</small></article><article class="kpi"><span>Visitors Today</span><strong>3,912</strong><small class="good">+18%</small></article><article class="kpi"><span>Open Support Tickets</span><strong>17</strong><small class="bad">Needs attention</small></article><article class="kpi"><span>Product Sales</span><strong>$12,430</strong><small class="good">+28%</small></article><article class="kpi"><span>System Health</span><strong>99.9%</strong><small class="good">Online</small></article></div>
<div class="grid-3" style="margin-top:10px" id="traffic"><article class="app-card" style="grid-column:span 2"><div class="card-head"><h2>Traffic Overview</h2><span class="tag">Visitors · Signups · Conversions</span></div><div class="chart"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d="M0 150 C70 135 90 170 150 120 S260 150 310 95 S410 140 480 88 S610 120 760 45" fill="none" stroke="#1488ff" stroke-width="4"/><path d="M0 175 C70 160 120 175 170 145 S280 170 330 128 S450 160 510 115 S640 140 760 78" fill="none" stroke="#21c991" stroke-width="3"/></svg></div></article><article class="app-card"><div class="card-head"><h2>Live Site Activity</h2><span class="tag good">Live</span></div>{['New user signed up','Indicator purchased','Course enrollment','Support ticket opened','Report downloaded'].map((x,i)=><div class="list-row"><div><b>{x}</b><small>{i+2} min ago</small></div><span class="tag">{['Organic','Sale','Course','Support','Member'][i]}</span></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="users"><div class="card-head"><h2>Recent Signups</h2><button class="control" data-admin-action="users">View all</button></div>{[['John Doe','Active'],['Sarah Rivera','Active'],['Michael Kim','Active'],['Emma Carter','Active'],['Daniel Lee','Review']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>Member account</small></div><span class={`tag ${x[1]==='Active'?'good':''}`}>{x[1]}</span></div>)}</article><article class="app-card" id="support"><div class="card-head"><h2>Support Inbox</h2><span class="tag bad">17 open</span></div>{[['Issue with login','High'],['Payment not going through','High'],['Indicator not loading','Medium'],['Refund request','Medium'],['Question about course','Low']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>Open ticket</small></div><button class="control" data-ticket>{x[1]}</button></div>)}</article><article class="app-card" id="email"><div class="card-head"><h2>Email Center</h2><button class="control primary" data-compose>Compose</button></div>{['Re: Account access issue','Course enrollment question','Payment confirmation','Indicator setup help','Refund request'].map(x=><div class="list-row"><div><b>{x}</b><small>Pending / received</small></div><span>→</span></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="products"><div class="card-head"><h2>Products / Indicators</h2><button class="control" data-admin-action="product">New Product</button></div>{[['Avata Pro Indicator','342 sales'],['Smart Money Pro','281 sales'],['Order Flow Elite','124 sales'],['Liquidity Tracker','96 sales']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>{x[1]}</small></div><button class="control" data-edit>Edit</button></div>)}</article><article class="app-card" id="courses"><div class="card-head"><h2>Courses</h2><button class="control" data-admin-action="course">New Course</button></div>{[['Price Action Mastery','482 enrollments'],['Options Trading Basics','316 enrollments'],['Risk Management','214 enrollments'],['Technical Analysis','192 enrollments']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>{x[1]}</small></div><button class="control" data-edit>Edit</button></div>)}</article><article class="app-card" id="content"><div class="card-head"><h2>Homepage & Banner Manager</h2><button class="control" data-admin-action="banner">New Banner</button></div>{[['Main Hero Banner',true],['Course Promotion Banner',true],['Indicator Showcase',true],['Community Banner',false]].map((x,i)=><div class="list-row"><div><b>{x[0]}</b><small>Homepage placement</small></div><button class={`control ${x[1]?'good':''}`} data-toggle-banner={i}>{x[1]?'ON':'OFF'}</button></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="analytics"><h2>Analytics & Journal Oversight</h2>{[['AI Trade Analytics','Active','2,841 uses'],['Trade Journal','Active','1,932 entries'],['Performance Reports','Active','1,204 reports'],['AI Reviews','Active','986 runs']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>{x[2]}</small></div><span class="tag good">{x[1]}</span></div>)}</article><article class="app-card" id="copy"><div class="card-head"><h2>Copy Trading Masters</h2><button class="control" data-admin-action="master">Create Master</button></div>{[['Temisi','8 / 20 followers','Active'],['Master Alpha','14 / 25 followers','Active'],['FX London','5 / 10 followers','Paused']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>{x[1]}</small></div><button class="control" data-master>{x[2]}</button></div>)}<p>Only Masters assigned by the platform owner receive Copy Trading dashboard access. Follower accounts do not receive dashboard access.</p></article><article class="app-card" id="integrations"><h2>Payments & Integrations</h2>{[['Payment Gateway','Ready for connection'],['Firebase','Pending connection'],['Email Routing','Domain stage'],['Trading API / VPS','Pending connection']].map(x=><div class="list-row"><span>{x[0]}</span><span class="tag">{x[1]}</span></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="roles"><div class="card-head"><h2>Roles & Permissions</h2><button class="control" data-admin-action="role">Manage</button></div>{[['Super Admins',2],['Administrators',4],['Support Agents',6],['Content Editors',3],['View Only',5]].map(x=><div class="list-row"><span>{x[0]}</span><b>{x[1]}</b></div>)}</article><article class="app-card" id="logs"><h2>System Logs / Recent Actions</h2>{['Updated homepage banner','Published new course','Updated product pricing','Resolved support ticket','Changed user permissions'].map((x,i)=><div class="list-row"><div><b>{x}</b><small>{i*18+5} min ago</small></div></div>)}</article><article class="app-card" id="reports"><h2>Reports & Exports</h2><div class="quick-grid"><button data-export>Users CSV</button><button data-export>Sales Report</button><button data-export>Support Report</button><button data-export>Copy Audit</button><button data-export>Course Progress</button><button data-export>Activity Logs</button></div></article></div>
<div class="modal" data-admin-modal><div class="modal-card"><div class="card-head"><h2 data-modal-title>Admin Action</h2><button class="control" data-modal-close>×</button></div><p data-modal-copy>Configure this item and save your changes.</p><div class="field"><label>Name / Title</label><input data-modal-input></div><div class="field"><label>Status</label><select><option>Active</option><option>Draft</option><option>Paused</option></select></div><button class="control primary" data-modal-save>Save</button><p data-modal-status class="good"></p></div></div>
<script is:inline>const m=document.querySelector('[data-admin-modal]');function openM(label){m.classList.add('open');document.querySelector('[data-modal-title]').textContent=label}document.querySelectorAll('[data-admin-action]').forEach(b=>b.onclick=()=>openM(b.textContent.trim()));document.querySelector('[data-quick]')?.addEventListener('click',()=>openM('Quick Action'));document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openM('Edit Item'));document.querySelectorAll('[data-ticket]').forEach(b=>b.onclick=()=>openM('Support Ticket'));document.querySelector('[data-compose]')?.addEventListener('click',()=>openM('Compose Email'));document.querySelectorAll('[data-master]').forEach(b=>b.onclick=()=>openM('Master Account'));document.querySelector('[data-modal-close]')?.addEventListener('click',()=>m.classList.remove('open'));document.querySelector('[data-modal-save]')?.addEventListener('click',()=>{localStorage.setItem('ta-admin-preview',document.querySelector('[data-modal-input]').value);document.querySelector('[data-modal-status]').textContent='Saved.'});document.querySelectorAll('[data-toggle-banner]').forEach(b=>b.onclick=()=>{b.textContent=b.textContent==='ON'?'OFF':'ON';b.classList.toggle('good')});document.querySelectorAll('[data-export]').forEach(b=>b.onclick=()=>{const blob=new Blob(['Trade Avata admin demo export'],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trade-avata-admin-export.txt';a.click()});</script></AppLayout>
