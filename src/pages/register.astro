---
import BaseLayout from '../layouts/BaseLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<BaseLayout title="Register | Trade Avata"><section class="page"><div class="shell"><form class="form-card" data-register><span class="eyebrow">CREATE ACCOUNT</span><h1>Start with Trade Avata</h1><div class="field"><label>Full name</label><input required></div><div class="field"><label>Email</label><input type="email" required></div><div class="field"><label>Password</label><input type="password" required></div><button class="button" style="width:100%">Create Account</button><p class="muted" style="font-size:11px">Create your account to save progress, purchases and workspace preferences.</p><p><a href={`${b}login/`}>Already have an account? Login</a></p></form></div></section><script is:inline>document.querySelector('[data-register]')?.addEventListener('submit',e=>{e.preventDefault();localStorage.setItem('ta-demo-login','1');location.href='../member/'});</script></BaseLayout>
