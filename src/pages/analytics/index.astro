---
import AppLayout from '../../layouts/AppLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const nav=[{label:'Dashboard',icon:'▥',href:'#overview',active:true},{label:'Performance',icon:'↗',href:'#performance'},{label:'Trades',icon:'▤',href:'#trades'},{label:'Calendar',icon:'□',href:'#calendar'},{label:'Strategies',icon:'◆',href:'#strategies'},{label:'Risk',icon:'△',href:'#risk'},{label:'Comparisons',icon:'⇄',href:'#comparisons'},{label:'Bookkeeping',icon:'₦',href:'#bookkeeping'},{label:'Insights',icon:'✦',href:'#insights'},{label:'AI Analytics',icon:'AI',href:'#ai'},{label:'Reports',icon:'▧',href:'#reports'},{label:'Downloads',icon:'⇩',href:'#downloads'},{label:'Accounts',icon:'◉',href:'#accounts'}];
const line='M0 190 C55 165 80 180 120 150 S200 160 240 125 S320 140 360 105 S430 118 470 88 S560 95 610 60 S690 70 760 35';
---
<AppLayout title="Analytics | Trade Avata" section="Analytics" nav={nav}><Fragment slot="top-left"><select><option>Primary Account · Demo · MT5</option><option>Challenge Account · Demo · cTrader</option></select><span class="control good">● Connected</span><select class="hide-phone"><option>Last 90 days</option><option>Last 30 days</option><option>This year</option></select></Fragment><Fragment slot="top-right"><button class="control hide-phone" data-sync>↻ Sync</button><button class="control primary hide-phone" data-export>Export</button></Fragment>
<div class="page-compact-head" id="overview"><div><h1>Trading Analytics</h1><p>Performance, risk, behavior and evidence in one workspace.</p></div><div><button class="control" data-layout>Layout</button> <button class="control primary" data-ai-open>AI Review</button></div></div>
<div class="dashboard-grid kpi-grid"><article class="kpi"><span>Net P&L</span><strong class="good">+$3,482.64</strong><small class="good">+4.21%</small></article><article class="kpi"><span>Win Rate</span><strong>68.4%</strong><small>42W / 20L</small></article><article class="kpi"><span>Total Trades</span><strong>62</strong><small class="good">+12%</small></article><article class="kpi"><span>Profit Factor</span><strong>1.84</strong><small>Target 1.5+</small></article><article class="kpi"><span>Max Drawdown</span><strong class="bad">8.7%</strong><small class="bad">-2.3%</small></article><article class="kpi"><span>Average R</span><strong>+0.42R</strong><small>Risk adjusted</small></article></div>
<div class="grid-2a" style="margin-top:10px"><article class="app-card" id="performance"><div class="card-head"><h2>Equity & Balance</h2><div><button class="control" data-chart-tab="Equity">Equity</button> <button class="control" data-chart-tab="Balance">Balance</button></div></div><div class="chart"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d={`${line} L760 220 L0 220Z`} fill="rgba(31,210,157,.12)"/><path d={line} fill="none" stroke="#24d0a0" stroke-width="4"/></svg></div><div class="grid-4" style="margin-top:10px"><div><small>Start</small><b>$10,000</b></div><div><small>Current</small><b>$13,482</b></div><div><small>Peak</small><b>$13,920</b></div><div><small>Drawdown</small><b class="bad">-8.7%</b></div></div></article><article class="app-card" id="accounts"><div class="card-head"><h2>Account Overview</h2><span class="tag good">DEMO</span></div><div class="stack"><div class="list-row"><span>Account</span><b>Primary Trading Account</b></div><div class="list-row"><span>Platform</span><b>MetaTrader 5</b></div><div class="list-row"><span>Broker</span><b>Example Broker</b></div><div class="list-row"><span>Currency</span><b>USD</b></div><div class="list-row"><span>Last Sync</span><b class="good">2 min ago</b></div></div><button class="control primary" style="margin-top:10px" data-account>Add / Manage Accounts</button></article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="comparisons"><div class="card-head"><h2>Period Comparison</h2><span class="tag">Current vs Previous</span></div><div class="bars">{[42,56,61,48,72,67,84,76].map((h,i)=><i style={`height:${h}%;background:${i%2?'linear-gradient(#24d0a0,#178cff)':'linear-gradient(#8b6bff,#1488ff)'}`}></i>)}</div></article><article class="app-card"><h2>Trade Distribution</h2><div style="display:flex;align-items:center;justify-content:center;position:relative;height:220px"><div class="donut"></div><div class="donut-label">62<br><small>Trades</small></div></div></article><article class="app-card" id="risk"><div class="card-head"><h2>Risk Profile</h2><span class="tag good">Controlled</span></div>{[['Max Drawdown','8.7%',44],['Avg Risk / Trade','1.2%',60],['Largest Loss','-1.9R',35],['Recovery Factor','2.4',72]].map(x=><div style="margin:14px 0"><div class="list-row"><span>{x[0]}</span><b>{x[1]}</b></div><div class="progress"><i style={`width:${x[2]}%`}></i></div></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card"><h2>Monthly Performance</h2><div class="bars" style="height:190px">{[33,55,42,72,61,80,47,68,84,75,92,86].map(h=><i style={`height:${h}%`}></i>)}</div></article><article class="app-card"><h2>Symbol Performance</h2>{[['EURUSD','+$1,240',78],['GBPUSD','+$846',66],['XAUUSD','+$521',58],['USDJPY','+$312',48],['US30','+$256',39]].map(x=><div class="list-row"><div style="width:100%"><b>{x[0]} <span class="good" style="float:right">{x[1]}</span></b><div class="progress" style="margin-top:6px"><i style={`width:${x[2]}%`}></i></div></div></div>)}</article><article class="app-card"><h2>Sessions & Day of Week</h2>{[['London','38%'],['New York','24%'],['Asia','20%'],['Sydney','10%']].map(x=><div class="list-row"><span>{x[0]}</span><b class="good">{x[1]}</b></div>)}</article></div>
<article class="app-card" id="trades" style="margin-top:10px"><div class="card-head"><h2>Recent Trades</h2><button class="control" data-trade>Add Manual Trade</button></div><div class="table-wrap"><table class="app-table"><thead><tr><th>Date</th><th>Symbol</th><th>Side</th><th>Volume</th><th>Entry</th><th>Exit</th><th>P&L</th><th>Strategy</th><th>Session</th><th>R</th></tr></thead><tbody><tr><td>Apr 30</td><td>EURUSD</td><td><span class="tag good">BUY</span></td><td>0.50</td><td>1.0724</td><td>1.0748</td><td class="good">+$240</td><td>Breakout</td><td>London</td><td>+2.1R</td></tr><tr><td>Apr 29</td><td>XAUUSD</td><td><span class="tag bad">SELL</span></td><td>0.30</td><td>2321.4</td><td>2317.2</td><td class="bad">-$180</td><td>Reversal</td><td>New York</td><td>-1.2R</td></tr><tr><td>Apr 29</td><td>GBPUSD</td><td><span class="tag good">BUY</span></td><td>0.20</td><td>1.2531</td><td>1.2487</td><td class="good">+$312</td><td>Pullback</td><td>London</td><td>+2.8R</td></tr></tbody></table></div></article>
<div class="grid-2" style="margin-top:10px"><article class="app-card" id="insights"><div class="card-head"><h2>Key Insights</h2><a class="control" href="#ai">Open AI →</a></div>{['Win rate improved by 7% compared with the prior period.','London session generated the largest share of profit.','XAUUSD loss concentration is higher than your EURUSD sample.','Average position size is above your recent baseline.'].map(x=><div class="list-row"><div><b>✦ {x}</b><small>Derived from the selected demo period</small></div></div>)}</article><article class="app-card" id="bookkeeping"><div class="card-head"><h2>Bookkeeping Snapshot</h2><button class="control" data-export>Export CSV</button></div><div class="grid-2"><div class="kpi"><span>Gross Profit</span><strong class="good">$5,940</strong></div><div class="kpi"><span>Gross Loss</span><strong class="bad">-$2,458</strong></div><div class="kpi"><span>Fees</span><strong>-$184</strong></div><div class="kpi"><span>Net</span><strong class="good">$3,298</strong></div></div></article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="strategies"><h2>Strategy Performance</h2>{[['Breakout','72%','+14.2R'],['Pullback','65%','+8.4R'],['Reversal','58%','+4.1R'],['Trend','69%','+10.8R']].map(x=><div class="list-row"><span>{x[0]}</span><b>{x[1]} · <span class="good">{x[2]}</span></b></div>)}</article><article class="app-card" id="calendar"><h2>Calendar Summary</h2><div class="grid-4">{Array.from({length:28},(_,i)=><span class={i%6===0?'tag bad':'tag good'} style="justify-content:center">{i+1}</span>)}</div></article><article class="app-card" id="reports"><h2>Reports & Downloads</h2><div class="quick-grid"><button data-export>Performance PDF</button><button data-export>Trading CSV</button><button data-export>Bookkeeping XLSX</button><button data-export>AI Review PDF</button></div></article></div>
<article class="app-card" id="ai" style="margin-top:10px"><div class="card-head"><div><h2>Trade Avata AI Analytics</h2><p>Evidence-based review. Missing information stays missing rather than being invented.</p></div><button class="control primary" data-ai-open>Generate Review</button></div><div class="grid-3"><div class="kpi"><span>Strongest Evidence</span><strong style="font-size:14px">London breakout setups</strong><small>Higher sample win rate and expectancy</small></div><div class="kpi"><span>Risk Watch</span><strong style="font-size:14px">Position size drift</strong><small>Above recent median on 8 trades</small></div><div class="kpi"><span>Review Next</span><strong style="font-size:14px">XAUUSD losses</strong><small>Check execution and setup quality</small></div></div></article>
<div class="modal" data-ai-modal><div class="modal-card"><div class="card-head"><h2>AI Analytics Review</h2><button class="control" data-close>×</button></div><p>The review uses recorded evidence from the selected period and keeps missing information clearly identified.</p><div class="notice" style="background:#0d2840;color:#c9e1f4;border-color:#244b6b">Observed demo evidence: performance improved while position-size variance increased. Review the trades responsible before changing risk rules.</div></div></div>
<script is:inline>const modal=document.querySelector('[data-ai-modal]');document.querySelectorAll('[data-ai-open]').forEach(b=>b.addEventListener('click',()=>modal.classList.add('open')));document.querySelector('[data-close]')?.addEventListener('click',()=>modal.classList.remove('open'));document.querySelectorAll('[data-export]').forEach(b=>b.addEventListener('click',()=>{const blob=new Blob(['Trade Avata demo export\nFrontend verification file'],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trade-avata-demo-export.txt';a.click();URL.revokeObjectURL(a.href)}));document.querySelector('[data-sync]')?.addEventListener('click',e=>{e.currentTarget.textContent='✓ Synced'});document.querySelector('[data-account]')?.addEventListener('click',()=>alert('Open account manager.'));document.querySelector('[data-trade]')?.addEventListener('click',()=>alert('Manual trade entry opened.'));document.querySelector('[data-layout]')?.addEventListener('click',()=>{const next=document.body.dataset.density==='compact'?'comfortable':'compact';document.body.dataset.density=next;localStorage.setItem('ta-app-density',next)});document.querySelectorAll('[data-chart-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-chart-tab]').forEach(x=>x.classList.remove('primary'));b.classList.add('primary')}));</script></AppLayout>
