---
import BaseLayout from '../layouts/BaseLayout.astro';import {products,courses} from '../data/site.js';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<BaseLayout><section style="background:#0b67bd;color:white;padding:9px 0;text-align:center;font-size:11px;font-weight:800">Trade Avata — tools, learning and intelligent review in one workspace.</section><section class="hero"><div class="shell hero-grid"><div><span class="eyebrow">TRADING TOOLS · LEARNING · INTELLIGENCE</span><h1>Trading is easier with the <span style="color:#53b9ff">right workspace.</span></h1><p>Trade Avata brings practical indicators, learning, AI-assisted analytics and a powerful trading journal into one connected platform.</p><div class="actions"><a class="button" href={`${b}register/`}>Get Started Free →</a><a class="pill" href={`${b}products/`}>Explore Indicators</a></div></div><div class="hero-visual" aria-label="Trading workspace preview"></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">FREE INTELLIGENCE</span><h2>Review your trading with better context.</h2></div><p>Advanced analytics and journaling are available as dedicated workspaces, built to help traders understand performance and decisions.</p></div><div class="grid grid-2"><article class="card"><div class="mock"></div><div class="card-body"><span class="badge">FREE AI ANALYTICS</span><h3>See what your trading data is saying.</h3><p>Performance, risk, comparisons, sessions, strategies, bookkeeping and evidence-based AI insights.</p><a class="button" href={`${b}analytics/`}>Open Analytics →</a></div></article><article class="card"><div class="mock"></div><div class="card-body"><span class="badge">FREE AI JOURNAL</span><h3>Record, review and improve.</h3><p>A flexible trade database with deep review, strategy, psychology, mistake and investigation workflows.</p><a class="button" href={`${b}journal/`}>Open Journal →</a></div></article></div></div></section>
<section class="section dark"><div class="shell"><div class="section-head"><div><span class="eyebrow">INDICATORS</span><h2>Tools built for real chart work.</h2></div><a class="pill" href={`${b}products/`}>View all indicators →</a></div><div class="grid grid-4">{products.map(p=><article class="card"><div class="mock"></div><div class="card-body"><span class="badge">{p.platform}</span><h3>{p.name}</h3><p>{p.desc}</p><strong>{p.price}</strong><div class="actions"><a class="button" href={`${b}products/${p.slug}/`}>View Details</a></div></div></article>)}</div></div></section>

<section class="section dark"><div class="shell"><div class="section-head"><div><span class="eyebrow">LIVE INDICATOR</span><h2>See an indicator in action.</h2></div><p>A focused chart preview that keeps the product experience visual before the user opens the full store.</p></div><a href={`${b}products/`} class="card" style="display:block;padding:12px;background:#071827;border-color:#28516e"><div class="chart" style="height:320px"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d="M0 175 C70 150 110 168 160 130 S260 150 320 100 S430 125 490 80 S610 105 760 45" fill="none" stroke="#22d0a0" stroke-width="4"/><path d="M0 195 C80 185 130 190 200 160 S320 175 390 140 S520 150 590 112 S680 125 760 90" fill="none" stroke="#198cff" stroke-width="3"/></svg></div><div class="card-body"><h3>Live Indicator Preview</h3><p>Open the indicator store to view available tools and platforms.</p></div></a></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">LEARN</span><h2>Courses that continue where you left off.</h2></div><a class="pill" style="color:var(--text)" href={`${b}courses/`}>Browse courses →</a></div><div class="grid grid-4">{courses.map(c=><article class="card"><div class="mock"></div><div class="card-body"><span class="badge">{c.level}</span><h3>{c.title}</h3><p>{c.lessons} lessons · {c.duration}</p><a class="button" href={`${b}courses/${c.slug}/`}>View Course</a></div></article>)}</div></div></section>
<section class="section dark"><div class="shell"><div class="grid grid-2"><div><span class="eyebrow">ONE ACCOUNT</span><h2 style="font-size:40px;margin:8px 0">Your progress stays connected.</h2><p style="color:#9fb2c6">Resume lessons, continue articles, find downloads, manage purchases and keep your learning activity in one member area.</p></div><div class="card"><div class="card-body"><h3>Member Dashboard</h3><p>Designed around your progress — not unnecessary trading statistics.</p><a class="button" href={`${b}member/`}>Preview Member Area →</a></div></div></div></div></section>
<section class="section dark"><div class="shell"><div class="grid grid-2" style="align-items:center"><div><span class="eyebrow">JOIN TRADE AVATA</span><h2 style="font-size:42px;margin:9px 0">Build a better trading workflow.</h2><p style="color:#9fb2c6">Create an account, continue your learning, access your products and use the advanced trading workspaces.</p></div><div style="text-align:right"><a class="button" href={`${b}register/`}>Get Started Free →</a></div></div></div></section><section class="section" style="padding:36px 0"><div class="shell" style="text-align:center"><h2>Stay connected with Trade Avata.</h2><p style="color:var(--muted)">Get product, course and platform updates.</p><form data-newsletter style="display:flex;gap:8px;justify-content:center;max-width:520px;margin:16px auto"><input type="email" required placeholder="Enter your email address" style="flex:1;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text)"><button class="button">Subscribe</button></form><small data-newsletter-status></small></div></section><script is:inline>document.querySelector('[data-newsletter]')?.addEventListener('submit',e=>{e.preventDefault();localStorage.setItem('ta-newsletter',e.target.querySelector('input').value);document.querySelector('[data-newsletter-status]').textContent='Subscribed.'});</script>
</BaseLayout>
