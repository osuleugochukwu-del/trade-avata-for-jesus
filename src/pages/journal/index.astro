---
import AppLayout from '../../layouts/AppLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const nav=[{label:'Journal Home',icon:'▥',href:'#home',active:true},{label:'New Entry',icon:'＋',href:'#database'},{label:'Trade Review',icon:'✎',href:'#reviews'},{label:'Daily Reviews',icon:'◷',href:'#reviews'},{label:'Weekly Reviews',icon:'▤',href:'#reviews'},{label:'Monthly Reviews',icon:'□',href:'#reviews'},{label:'Investigations',icon:'⌕',href:'#investigations'},{label:'Playbook',icon:'◇',href:'#playbook'},{label:'Strategies',icon:'◆',href:'#strategies'},{label:'Notes',icon:'▱',href:'#database'},{label:'Mistakes',icon:'!',href:'#psychology'},{label:'Tags',icon:'#',href:'#database'},{label:'Templates',icon:'▧',href:'#database'},{label:'Media',icon:'▣',href:'#database'},{label:'Settings',icon:'⚙',href:'#settings'}];
---
<AppLayout title="Trading Journal | Trade Avata" section="Journal" nav={nav}><Fragment slot="top-left"><select><option>London Account · MT5</option><option>Challenge Account · cTrader</option></select><span class="control good">● Connected</span></Fragment><Fragment slot="top-right"><button class="control" data-import>Import</button><button class="control" data-export>Export</button><button class="control primary" data-new>＋ New Entry</button></Fragment>
<div class="page-compact-head" id="home"><div><h1>Trading Journal</h1><p>Your trades, decisions, reviews and behavior — connected.</p></div><div><button class="control" data-review>✦ AI Review</button></div></div>
<div class="dashboard-grid kpi-grid"><article class="kpi"><span>Journal Entries</span><strong>184</strong><small class="good">+12 this month</small></article><article class="kpi"><span>Reviewed Trades</span><strong>82%</strong><small>151 completed</small></article><article class="kpi"><span>Avg Setup Quality</span><strong>7.8/10</strong><small class="good">+0.4</small></article><article class="kpi"><span>Avg Execution</span><strong>7.1/10</strong><small>Needs review</small></article><article class="kpi"><span>Best Setup</span><strong>A+</strong><small class="good">Breakout · 72%</small></article><article class="kpi"><span>Most Common Mistake</span><strong class="bad" style="font-size:16px">Early Entry</strong><small>14 occurrences</small></article></div>
<div class="grid-2a" style="margin-top:10px"><article class="app-card"><div class="card-head"><h2>Journal Performance Overview</h2><span class="tag">30D</span></div><div class="chart"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d="M0 180 C70 150 90 170 140 138 S220 145 280 112 S360 125 420 92 S520 105 590 68 S680 78 760 35 L760 220 L0 220Z" fill="rgba(31,210,157,.12)"/><path d="M0 180 C70 150 90 170 140 138 S220 145 280 112 S360 125 420 92 S520 105 590 68 S680 78 760 35" fill="none" stroke="#23d0a0" stroke-width="4"/></svg></div></article><article class="app-card"><div class="card-head"><h2>Review Calendar</h2><span class="tag">September</span></div><div class="grid-4">{Array.from({length:28},(_,i)=><span class={i%7===0?'tag bad':i%3===0?'tag good':'tag'} style="justify-content:center;padding:9px 4px">{i+1}</span>)}</div><div class="list-row"><span>Entries this month</span><b>24</b></div><div class="list-row"><span>Reviews completed</span><b class="good">19</b></div></article></div>
<div class="grid-4" style="margin-top:10px"><article class="app-card"><h2>Performance by Symbol</h2>{[['EURUSD','+$1,840'],['XAUUSD','+$620'],['NAS100','+$490'],['GBPUSD','-$310']].map(x=><div class="list-row"><span>{x[0]}</span><b class={x[1].includes('-')?'bad':'good'}>{x[1]}</b></div>)}</article><article class="app-card" id="strategies"><h2>Setup Performance</h2><div style="display:flex;justify-content:center;position:relative;margin:12px"><div class="donut"></div><div class="donut-label">72%<br><small>A+ / A</small></div></div></article><article class="app-card" id="psychology"><h2>Emotions</h2>{[['Calm',42,42],['Confident',28,28],['Frustrated',12,12],['Nervous',8,8],['FOMO',6,6]].map(x=><div style="margin:10px 0"><small>{x[0]} · {x[1]}%</small><div class="progress"><i style={`width:${x[2]}%`}></i></div></div>)}</article><article class="app-card"><h2>Top Tags</h2>{['#Breakout 42','#London 38','#Pullback 31','#Trend 24','#Reversal 18','#News 12'].map(x=><div class="list-row"><span>{x}</span></div>)}</article></div>
<article class="workspace-table" id="database" style="margin-top:10px"><div class="workspace-toolbar"><div><button data-view="table">▤ Table</button><button data-view="gallery">▦ Gallery</button><button data-property>＋ Property</button></div><div><input data-search placeholder="Search trades…"><button data-filter>≡ Filter</button><button data-sort>↕ Sort</button></div></div><div class="table-wrap"><table class="app-table" style="min-width:1100px"><thead><tr><th>Trade</th><th>Position</th><th>Session</th><th>Date</th><th>Type</th><th>Confirmation</th><th>RR</th><th>Entry TF</th><th>Risk</th><th>Forecast</th><th>Strategy</th><th>Outcome</th></tr></thead><tbody data-journal-body></tbody></table></div><button class="control" style="margin:10px" data-new>＋ New trade</button><div data-gallery-area hidden style="padding:12px" class="grid-3"></div></article>
<div class="grid-3" style="margin-top:10px" id="reviews"><article class="app-card"><h2>Trade Review</h2><div class="chart" style="height:170px"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d="M0 160 C90 130 130 160 210 110 S340 145 430 90 S590 130 760 55" fill="none" stroke="#19c8ff" stroke-width="4"/></svg></div><div class="list-row"><span>Setup quality</span><b>★★★★☆</b></div><div class="list-row"><span>Execution quality</span><b>★★★☆☆</b></div><button class="control primary" data-open-first>Open selected trade</button></article><article class="app-card" id="investigations"><div class="card-head"><h2>Investigations</h2><button class="control" data-investigate>New</button></div>{['Does London breakout perform better?','Does early entry reduce expectancy?','Does FOMO correlate with oversizing?'].map((x,i)=><div class="list-row"><div><b>{x}</b><small>{i===0?'Completed':'In progress'}</small></div><span class={i===0?'tag good':'tag'}>{i===0?'Done':'Open'}</span></div>)}</article><article class="app-card" id="playbook"><div class="card-head"><h2>Playbook</h2><button class="control" data-playbook>Add Setup</button></div>{[['A+ London Breakout','72% win'],['Liquidity Sweep Reversal','64% win'],['NY Pullback','61% win']].map(x=><div class="list-row"><div><b>{x[0]}</b><small>{x[1]}</small></div><span>→</span></div>)}</article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card"><h2>Mistake Patterns</h2>{[['Early Entry',14,'bad'],['Moved Stop',8,'bad'],['No HTF Alignment',6,'bad'],['Overtrade',4,'bad']].map(x=><div class="list-row"><span>{x[0]}</span><b class={x[2]}>{x[1]}</b></div>)}</article><article class="app-card"><h2>Discipline & Process</h2><div class="kpi"><span>Plan Adherence</span><strong>81%</strong><small class="good">+6% this month</small></div><div class="kpi" style="margin-top:8px"><span>Review Completion</span><strong>82%</strong><small>151 / 184 entries</small></div></article><article class="app-card"><h2>AI Journal Insights</h2>{['Early entries appear most often after a prior loss.','A+ setups have stronger execution scores than B setups.','Calm trades have lower average risk variance.'].map(x=><div class="list-row"><div><b>✦ {x}</b><small>Evidence-based demo observation</small></div></div>)}</article></div>
<div class="drawer" data-drawer><div class="drawer-panel"><div class="card-head"><div><span class="tag">TRADE RECORD</span><h2 data-drawer-title style="font-size:24px;margin-top:8px">EURUSD</h2></div><button class="control" data-close>×</button></div><div class="field"><label>Symbol</label><input data-f="symbol"></div><div class="grid-2"><div class="field"><label>Direction</label><select data-f="position"><option>BUY</option><option>SELL</option></select></div><div class="field"><label>Strategy</label><select data-f="strategy"><option>Breakout</option><option>Pullback</option><option>Reversal</option></select></div></div><div class="field"><label>Setup / Thesis</label><textarea data-f="thesis" rows="4"></textarea></div><div class="field"><label>Confluences</label><input data-f="confirmation" placeholder="Sweep, MSS, FVG..."></div><div class="grid-2"><div class="field"><label>Setup Quality 1–10</label><input data-f="setup" type="number" min="1" max="10"></div><div class="field"><label>Execution Quality 1–10</label><input data-f="execution" type="number" min="1" max="10"></div></div><div class="field"><label>Emotion</label><select data-f="emotion"><option>Calm</option><option>Confident</option><option>Frustrated</option><option>Nervous</option><option>FOMO</option></select></div><div class="field"><label>Mistakes / Notes</label><textarea data-f="notes" rows="4"></textarea></div><div class="field"><label>Lesson</label><textarea data-f="lesson" rows="4"></textarea></div><div class="field"><label>Screenshot / Evidence link</label><input data-f="evidence"></div><button class="control primary" data-save>Save Trade</button> <button class="control" data-ai-trade>✦ AI Review</button><p data-save-status style="font-size:10px;color:var(--app-good)"></p></div></div>
<div class="modal" data-property-modal><div class="modal-card"><div class="card-head"><h2>Journal Properties</h2><button class="control" data-property-close>×</button></div><p>Create reusable fields for every trade — Notion-style flexibility inside the Trade Avata journal.</p><div class="field"><label>Property name</label><input data-prop-name placeholder="e.g. Emotion, HTF Bias, News Context"></div><div class="field"><label>Type</label><select data-prop-type><option>Text</option><option>Select</option><option>Multi-select</option><option>Number</option><option>Checkbox</option></select></div><button class="control primary" data-prop-save>Add Property</button><div data-prop-list style="margin-top:12px"></div></div></div>
<script is:inline>
const seed=[{id:'t1',symbol:'EURUSD',position:'BUY',session:'London',date:'2026-09-28',type:'Breakout',confirmation:'Sweep, MSS',rr:'1:2.1',tf:'1H',risk:'0.5%',forecast:'High',strategy:'Breakout',outcome:'Win',thesis:'London breakout above resistance with confirmation.',setup:9,execution:8,emotion:'Calm',notes:'Followed plan.',lesson:'Keep confirmation sequence consistent.'},{id:'t2',symbol:'XAUUSD',position:'SELL',session:'New York',date:'2026-09-27',type:'Reversal',confirmation:'FVG, MSS',rr:'1:1.4',tf:'15m',risk:'0.5%',forecast:'Medium',strategy:'Reversal',outcome:'Loss',thesis:'Reversal from higher-timeframe level.',setup:7,execution:5,emotion:'Frustrated',notes:'Entered early.',lesson:'Wait for complete trigger.'},{id:'t3',symbol:'GBPUSD',position:'BUY',session:'London',date:'2026-09-26',type:'Pullback',confirmation:'HTF, Sweep',rr:'1:1.8',tf:'1H',risk:'0.4%',forecast:'High',strategy:'Pullback',outcome:'Win',thesis:'Pullback into structure.',setup:8,execution:8,emotion:'Confident',notes:'Clean execution.',lesson:'Repeat same risk process.'}];
let trades=JSON.parse(localStorage.getItem('ta-journal-v1')||'null')||seed;let selected=trades[0]?.id;const body=document.querySelector('[data-journal-body]');const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));function render(){const q=(document.querySelector('[data-search]')?.value||'').toLowerCase();const rows=trades.filter(t=>JSON.stringify(t).toLowerCase().includes(q));body.innerHTML=rows.map(t=>`<tr data-id="${esc(t.id)}"><td><b>${esc(t.symbol)}</b></td><td><span class="tag ${t.position==='BUY'?'good':'bad'}">${esc(t.position)}</span></td><td>${esc(t.session)}</td><td>${esc(t.date)}</td><td>${esc(t.type)}</td><td>${esc(t.confirmation)}</td><td>${esc(t.rr)}</td><td>${esc(t.tf)}</td><td>${esc(t.risk)}</td><td>${esc(t.forecast)}</td><td>${esc(t.strategy)}</td><td><span class="tag ${t.outcome==='Win'?'good':'bad'}">${esc(t.outcome)}</span></td></tr>`).join('');body.querySelectorAll('tr').forEach(r=>r.onclick=()=>openTrade(r.dataset.id))}function openTrade(id){selected=id;const t=trades.find(x=>x.id===id);if(!t)return;document.querySelector('[data-drawer]').classList.add('open');document.querySelector('[data-drawer-title]').textContent=t.symbol;['symbol','position','strategy','thesis','confirmation','setup','execution','emotion','notes','lesson','evidence'].forEach(k=>{const el=document.querySelector(`[data-f="${k}"]`);if(el)el.value=t[k]??''})}function newTrade(){const id='t'+Date.now();trades.unshift({id,symbol:'Untitled',position:'BUY',session:'London',date:new Date().toISOString().slice(0,10),type:'Setup',confirmation:'',rr:'',tf:'1H',risk:'0.5%',forecast:'',strategy:'Breakout',outcome:'Open',thesis:'',setup:7,execution:7,emotion:'Calm',notes:'',lesson:''});selected=id;render();openTrade(id)}document.querySelectorAll('[data-new]').forEach(b=>b.addEventListener('click',newTrade));document.querySelector('[data-close]')?.addEventListener('click',()=>document.querySelector('[data-drawer]').classList.remove('open'));document.querySelector('[data-save]')?.addEventListener('click',()=>{const t=trades.find(x=>x.id===selected);['symbol','position','strategy','thesis','confirmation','setup','execution','emotion','notes','lesson','evidence'].forEach(k=>{const el=document.querySelector(`[data-f="${k}"]`);if(el)t[k]=el.value});localStorage.setItem('ta-journal-v1',JSON.stringify(trades));document.querySelector('[data-save-status]').textContent='Saved on this device.';render()});document.querySelector('[data-search]')?.addEventListener('input',render);document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{const gallery=document.querySelector('[data-gallery-area]');const table=document.querySelector('#database .table-wrap');if(b.dataset.view==='gallery'){table.hidden=true;gallery.hidden=false;gallery.innerHTML=trades.map(t=>`<button class="app-card" style="text-align:left;color:inherit" data-gallery-id="${esc(t.id)}"><span class="tag ${t.position==='BUY'?'good':'bad'}">${esc(t.position)}</span><h3 style="margin-top:8px">${esc(t.symbol)}</h3><p>${esc(t.strategy)} · ${esc(t.session)} · ${esc(t.date)}</p><small>${esc(t.thesis)}</small></button>`).join('');gallery.querySelectorAll('[data-gallery-id]').forEach(x=>x.onclick=()=>openTrade(x.dataset.galleryId))}else{table.hidden=false;gallery.hidden=true}}));document.querySelector('[data-sort]')?.addEventListener('click',()=>{trades.reverse();render()});document.querySelector('[data-filter]')?.addEventListener('click',()=>{trades=trades.filter(t=>t.outcome==='Win');render();setTimeout(()=>{trades=JSON.parse(localStorage.getItem('ta-journal-v1')||'null')||seed;render()},4000)});document.querySelector('[data-property]')?.addEventListener('click',()=>document.querySelector('[data-property-modal]').classList.add('open'));document.querySelector('[data-property-close]')?.addEventListener('click',()=>document.querySelector('[data-property-modal]').classList.remove('open'));document.querySelector('[data-prop-save]')?.addEventListener('click',()=>{const n=document.querySelector('[data-prop-name]').value.trim();if(!n)return;const arr=JSON.parse(localStorage.getItem('ta-journal-props')||'[]');arr.push(n);localStorage.setItem('ta-journal-props',JSON.stringify(arr));document.querySelector('[data-prop-list]').innerHTML=arr.map(x=>`<span class="tag" style="margin:4px">${esc(x)}</span>`).join('')});document.querySelector('[data-ai-trade]')?.addEventListener('click',()=>alert('AI review uses only the evidence recorded in this trade.'));document.querySelector('[data-review]')?.addEventListener('click',()=>alert('Journal AI review uses the selected period and recorded evidence.'));document.querySelector('[data-open-first]')?.addEventListener('click',()=>openTrade(trades[0].id));document.querySelector('[data-investigate]')?.addEventListener('click',()=>alert('New investigation created. Add a question, filters and review period.'));document.querySelector('[data-playbook]')?.addEventListener('click',()=>alert('New playbook setup created.'));document.querySelector('[data-export]')?.addEventListener('click',()=>{const blob=new Blob([JSON.stringify(trades,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trade-avata-journal.json';a.click()});document.querySelector('[data-import]')?.addEventListener('click',()=>alert('Choose a Trade Avata journal export to import.'));render();
</script></AppLayout>
