---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courses } from '../../data/site.js';

export async function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<BaseLayout title={`${course.title} | Trade Avata`}>
  <section class="page">
    <div class="shell">

      <span class="eyebrow">
        {course.level}
      </span>

      <h1 class="page-title">
        {course.title}
      </h1>

      <p class="lead">
        A structured course with {course.lessons} lessons.
        Your progress can be resumed from the member dashboard.
      </p>

      <div
        class="grid grid-2"
        style="margin-top:28px"
      >

        <div class="card">

          <div
            class="mock"
            style="height:300px"
          ></div>

          <div class="card-body">

            <h3>
              Course overview
            </h3>

            <p>
              {course.duration} total learning time with practical lesson checkpoints and saved progress.
            </p>

            <a
              class="button"
              href={`${base}courses/${course.slug}/player/`}
            >
              Start / Continue Course →
            </a>

          </div>
        </div>

        <div class="card">
          <div class="card-body">

            <h3>
              Lessons
            </h3>

            {
              Array.from(
                {
                  length: Math.min(
                    course.lessons,
                    10
                  )
                },
                (_, i) => (
                  <p
                    style="
                      padding:9px 0;
                      border-bottom:1px solid var(--line);
                    "
                  >
                    <b>
                      {i + 1}.
                    </b>{' '}

                    {
                      i === 0
                        ? 'Introduction & learning plan'
                        : i === 1
                        ? 'Core concepts'
                        : i === 2
                        ? 'Market examples'
                        : i === 3
                        ? 'Decision framework'
                        : `Practical lesson ${i + 1}`
                    }
                  </p>
                )
              )
            }

          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
