---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { courses } from '../../../data/site.js';

export async function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<BaseLayout title={`${course.title} Player | Trade Avata`}>
  <section class="page">
    <div class="shell">
      <div
        class="grid grid-2"
        style="grid-template-columns:1.5fr .5fr"
      >
        <div>
          <div
            class="mock"
            style="
              height:420px;
              border-radius:18px;
              display:grid;
              place-items:center;
              color:white;
              font-size:50px;
            "
          >
            ▶
          </div>

          <h1
            data-lesson-title
            style="margin:18px 0 6px"
          >
            Lesson 4 — Continue your course
          </h1>

          <p class="lead">
            Your lesson position is remembered so you can continue from where you stopped.
          </p>

          <div class="actions">
            <button
              class="button"
              data-complete
            >
              Mark Lesson Complete
            </button>

            <a
              class="pill"
              style="color:var(--text)"
              href={`${base}member/`}
            >
              Back to Dashboard
            </a>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <h3>{course.title}</h3>

            <div class="progress">
              <i style={`width:${course.progress}%`}></i>
            </div>

            <p>{course.progress}% complete</p>

            {
              Array.from(
                { length: Math.min(course.lessons, 10) },
                (_, i) => (
                  <button
                    class="pill"
                    data-lesson={i + 1}
                    style="
                      width:100%;
                      color:var(--text);
                      margin:5px 0;
                      text-align:left;
                    "
                  >
                    Lesson {i + 1}
                  </button>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const title = document.querySelector(
      '[data-lesson-title]'
    );

    document
      .querySelector('[data-complete]')
      ?.addEventListener('click', () => {
        localStorage.setItem(
          'ta-course-progress',
          'lesson-4-complete'
        );

        alert('Lesson marked complete.');
      });

    document
      .querySelectorAll('[data-lesson]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const lesson =
            button.dataset.lesson;

          localStorage.setItem(
            'ta-current-lesson',
            lesson
          );

          if (title) {
            title.textContent =
              `Lesson ${lesson} — Continue your course`;
          }
        });
      });
  </script>
</BaseLayout>
