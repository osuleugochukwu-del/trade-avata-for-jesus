---
import BaseLayout from '../../../layouts/BaseLayout.astro';import {courses} from '../../../data/site.js';export function getStaticPaths(){return courses.map(c=>({params:{slug:c.slug},props:{c}}))}const {c}=Astro.props;const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<BaseLayout title={`${c.title} Player | Trade Avata`}><section class="page"><div class="shell"><div class="grid grid-2" style="grid-template-columns:1.5fr .5fr"><div><div class="mock" style="height:420px;border-radius:18px;display:grid;place-items:center;color:white;font-size:50px">▶</div><h1 style="margin:18px 0 6px">Lesson 4 — Continue your course</h1><p class="lead">Your lesson position is remembered so you can continue from where you stopped.</p><div class="actions"><button class="button" data-complete>Mark Lesson Complete</button><a class="pill" style="color:var(--text)" href={`${b}member/`}>Back to Dashboard</a></div></div><div class="card"><div class="card-body"><h3>{c.title}</h3><div class="progress"><i style={`width:${c.progress}%`}></i></div><p>{c.progress}% complete</p>{Array.from({length:8},(_,i)=><button class="pill" data-lesson={i+1} style="width:100%;color:var(--text);margin:5px 0;text-align:left">Lesson {i+1}</button>)}</div></div></div></div></section><script is:inline>document.querySelector('[data-complete]')?.addEventListener('click',()=>{localStorage.setItem('ta-course-progress','lesson-4-complete');alert('Lesson marked complete.')});document.querySelectorAll('[data-lesson]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('ta-current-lesson',b.dataset.lesson);document.querySelector('h1').textContent='Lesson '+b.dataset.lesson+' — Continue your course'}));</script></BaseLayout>
