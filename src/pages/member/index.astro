---
import AppLayout from '../../layouts/AppLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const nav=[{label:'Dashboard',icon:'⌂',href:`${b}member/`,active:true},{label:'My Courses',icon:'▣',href:`${b}courses/`},{label:'My Library',icon:'▤',href:`${b}articles/`},{label:'My Purchases',icon:'▱',href:`${b}products/`},{label:'Saved Content',icon:'♡',href:'#saved'},{label:'Downloads',icon:'⇩',href:'#downloads'},{label:'Certificates',icon:'◇',href:'#certificates'},{label:'Notifications',icon:'◌',href:'#activity'},{label:'Support',icon:'?',href:`${b}contact/`},{label:'Profile',icon:'○',href:'#profile'},{label:'Settings',icon:'⚙',href:'#settings'}];
---
<AppLayout title="Member Dashboard | Trade Avata" section="Member" nav={nav} profile="Temisi"><Fragment slot="top-left"><input class="search-wide" placeholder="Search courses, articles, indicators..." style="width:min(520px,45vw)"></Fragment><Fragment slot="top-right"><button class="control" data-app-theme-toggle>◐</button><button class="control">🔔 3</button></Fragment>
<section class="app-card" style="padding:16px;background:linear-gradient(110deg,#0b2440,#0f4b82);margin-bottom:10px"><div class="page-compact-head" style="margin:0"><div><p style="margin:0;color:#b8d2e7">Welcome back,</p><h1 style="font-size:30px">Temisi 👋</h1><p>Continue your learning journey, access your resources and manage your account in one place.</p></div><div class="copy-hide-mobile" style="max-width:260px;border:1px solid #315d82;border-radius:12px;padding:12px;font-size:12px">“Discipline today creates the freedom you want tomorrow.”</div></div></section>
<div class="dashboard-grid kpi-grid" style="margin-bottom:10px"><article class="kpi"><span>Enrolled Courses</span><strong>3</strong><small>1 nearly complete</small></article><article class="kpi"><span>Lessons Completed</span><strong>12</strong><small class="good">+4 this week</small></article><article class="kpi"><span>Articles Read</span><strong>8</strong><small>2 saved for later</small></article><article class="kpi"><span>Purchased Items</span><strong>5</strong><small>All active</small></article><article class="kpi"><span>Downloads</span><strong>7</strong><small>2 updates available</small></article><article class="kpi"><span>Saved Content</span><strong>4</strong><small>Courses & articles</small></article></div>
<div class="grid-2a"><article class="app-card"><div class="card-head"><h2>Continue Where You Left Off</h2><a class="control" href={`${b}courses/trading-basics/player/`}>View course →</a></div><div class="grid-2" style="grid-template-columns:.75fr 1.25fr"><div class="chart" style="height:190px;display:grid;place-items:center;font-size:40px">▶</div><div><span class="tag">COURSE</span><h2 style="font-size:18px;margin-top:9px">Price Action Mastery</h2><p>Module 2 · Market Structure<br>Lesson 4 · Higher Highs and Lower Lows</p><div class="progress"><i style="width:45%"></i></div><p>12:45 / 38:20 · 45%</p><a class="control primary" href={`${b}courses/trading-basics/player/`}>▶ Continue Watching</a></div></div></article><article class="app-card"><div class="card-head"><h2>My Learning Progress</h2><span class="tag">This month</span></div><div style="display:flex;gap:18px;align-items:center"><div style="position:relative"><div class="donut"></div><div class="donut-label" style="inset:45px 0 auto">60%<br><small>Overall</small></div></div><div class="stack" style="flex:1"><div><small>Courses 60%</small><div class="progress"><i style="width:60%"></i></div></div><div><small>Articles 70%</small><div class="progress"><i style="width:70%"></i></div></div><div><small>Downloads 40%</small><div class="progress"><i style="width:40%"></i></div></div></div></div><div class="list-row"><div><b>🔥 Current Learning Streak</b><small>Keep it up</small></div><strong style="color:var(--app-gold)">5 Days</strong></div></article></div>
<div class="grid-3" style="margin-top:10px"><article class="app-card"><div class="card-head"><h2>My Courses</h2><a href={`${b}courses/`}>View all →</a></div>{['Forex Foundations — 80%','Risk Management & Psychology — 35%','Advanced Strategies — 20%'].map((x,i)=><div class="list-row"><div style="flex:1"><b>{x}</b><div class="progress" style="margin-top:6px"><i style={`width:${[80,35,20][i]}%`}></i></div></div><a class="control" href={`${b}courses/${['trading-basics','risk-management','advanced-strategies'][i]}/`}>Continue</a></div>)}</article><article class="app-card" id="downloads"><div class="card-head"><h2>My Purchases & Downloads</h2><a href={`${b}products/`}>View all →</a></div>{['Trend Master Pro · MT5 · v2.1','Support & Resistance · cTrader · v1.4','Volume Scanner · v3.0','Price Action E-Book · PDF'].map(x=><div class="list-row"><div><b>{x}</b><small>Available in your library</small></div><button class="control" data-download>Download</button></div>)}</article><article class="app-card" id="activity"><div class="card-head"><h2>Recent Activity</h2><span class="tag">LIVE</span></div>{['Watched lesson 4 in Price Action Mastery','Read article: Trend vs Range Market','Downloaded Trend Master Pro v2.1','Saved article: Risk Management Tips','Purchased Volume Scanner Indicator'].map((x,i)=><div class="list-row"><div><b>{x}</b><small>{i<2?'Today':'Recently'}</small></div></div>)}</article></div>
<div class="grid-2" style="margin-top:10px"><article class="app-card" id="saved"><div class="card-head"><h2>Recommended For You</h2><a href={`${b}courses/`}>Explore →</a></div><div class="grid-4">{['Advanced Risk Management','Mastering Market Structure','Trading Psychology Deep Dive','Top 10 Indicators'].map(x=><div style="border:1px solid #1e3f5c;border-radius:10px;padding:11px"><b style="font-size:10px">{x}</b><small style="display:block;color:var(--app-muted);margin-top:5px">Based on your recent learning</small></div>)}</div></article><article class="app-card"><h2>Support & Help</h2><p>Get help with your purchases, courses or account.</p><a class="control primary" href={`${b}contact/`}>Contact Support</a></article></div>

<div class="grid-3" style="margin-top:10px"><article class="app-card" id="certificates"><h2>Certificates</h2><div class="list-row"><div><b>Trading Foundations</b><small>Course completion certificate</small></div><button class="control" data-certificate>View</button></div></article><article class="app-card" id="profile"><h2>Profile</h2><div class="list-row"><span>Name</span><b>Temisi</b></div><div class="list-row"><span>Member since</span><b>2026</b></div><button class="control" data-profile>Edit Profile</button></article><article class="app-card" id="settings"><h2>Member Settings</h2><div class="list-row"><span>Learning reminders</span><button class="control" data-setting>On</button></div><div class="list-row"><span>Product updates</span><button class="control" data-setting>On</button></div></article></div>
<script is:inline>document.querySelectorAll('[data-download]').forEach(b=>b.addEventListener('click',()=>{b.textContent='Ready';localStorage.setItem('ta-download-ready','1')}));document.querySelectorAll('[data-setting]').forEach(b=>b.addEventListener('click',()=>b.textContent=b.textContent==='On'?'Off':'On'));document.querySelector('[data-certificate]')?.addEventListener('click',()=>alert('Certificate viewer opened.'));document.querySelector('[data-profile]')?.addEventListener('click',()=>alert('Profile editor opened.'));</script></AppLayout>
