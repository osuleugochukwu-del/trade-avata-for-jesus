---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Trade Avata"><section class="page"><div class="shell"><span class="eyebrow">SUPPORT</span><h1 class="page-title">How can we help?</h1><p class="lead">Send a support request and our team can follow up with you.</p><form class="form-card" data-form><div class="field"><label>Name</label><input required></div><div class="field"><label>Email</label><input type="email" required></div><div class="field"><label>Topic</label><select><option>Account</option><option>Course</option><option>Indicator</option><option>Analytics</option><option>Journal</option><option>Copy Trading</option></select></div><div class="field"><label>Message</label><textarea rows="6" required></textarea></div><button class="button">Submit Request</button><p data-status class="muted" style="font-size:11px"></p></form></div></section><script is:inline>document.querySelector('[data-form]')?.addEventListener('submit',e=>{e.preventDefault();localStorage.setItem('ta-contact-draft',JSON.stringify(Object.fromEntries(new FormData(e.target))));document.querySelector('[data-status]').textContent='Your support request has been saved.'});</script></BaseLayout>
