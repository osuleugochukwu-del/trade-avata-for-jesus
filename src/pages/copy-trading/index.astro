---
import AppLayout from '../../layouts/AppLayout.astro';const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
const nav=[{label:'Overview',icon:'▥',href:'#overview',active:true},{label:'Follower Accounts',icon:'◉',href:'#followers'},{label:'Copy Rules',icon:'⇄',href:'#rules'},{label:'Risk Controls',icon:'△',href:'#risk'},{label:'Live Trades',icon:'↗',href:'#trades'},{label:'History',icon:'▤',href:'#history'},{label:'Reports',icon:'▧',href:'#reports'},{label:'Connection Health',icon:'●',href:'#health'},{label:'Support',icon:'?',href:`${b}contact/`}];
---
<AppLayout title="Copy Trading | Trade Avata" section="Master Copy Trading" nav={nav} profile="Master · Temisi"><Fragment slot="top-left"><span class="control primary">MASTER ACCESS</span><span class="control good">● Service Online</span><span class="control hide-phone">Capacity: 8 / 20 accounts</span></Fragment><Fragment slot="top-right"><button class="control" data-sync>↻ Sync</button><button class="control primary" data-add-account>＋ Add Follower Account</button></Fragment>
<div class="page-compact-head" id="overview"><div><h1>Copy Trading Control Center</h1><p>Master-only workspace for managing follower accounts, copying rules and execution health.</p></div><div class="tag good">Owner-assigned Master</div></div>
<div class="dashboard-grid kpi-grid"><article class="kpi"><span>Follower Accounts</span><strong>8</strong><small>7 live · 1 demo</small></article><article class="kpi"><span>Active Copying</span><strong>7</strong><small class="good">All healthy</small></article><article class="kpi"><span>Paused Accounts</span><strong>1</strong><small>Manual pause</small></article><article class="kpi"><span>Open Copied Trades</span><strong>12</strong><small>Across followers</small></article><article class="kpi"><span>Copy Success Rate</span><strong>99.3%</strong><small class="good">Last 24h</small></article><article class="kpi"><span>Connection Health</span><strong class="good">96/100</strong><small>Stable</small></article></div>
<div class="grid-2a" style="margin-top:10px"><article class="app-card"><div class="card-head"><h2>Copy Activity</h2><div><button class="control">24H</button> <button class="control">7D</button> <button class="control">30D</button></div></div><div class="chart"><svg viewBox="0 0 760 220" preserveAspectRatio="none"><path d="M0 175 C65 150 95 168 140 138 S240 142 290 108 S375 120 430 88 S515 98 590 64 S690 70 760 38" fill="none" stroke="#1bc69d" stroke-width="4"/><path d="M0 190 C75 175 105 180 160 155 S250 160 320 130 S410 145 480 115 S600 122 760 80" fill="none" stroke="#1488ff" stroke-width="3" opacity=".8"/></svg></div><div class="grid-4" style="margin-top:9px"><div><small>Copied Orders</small><b>326</b></div><div><small>Avg Delay</small><b>0.8s</b></div><div><small>Failed Copies</small><b class="bad">2</b></div><div><small>Recovered</small><b class="good">2</b></div></div></article><article class="app-card" id="health"><div class="card-head"><h2>Service & Connection Health</h2><span class="tag good">LIVE</span></div>{[['Master terminal','Connected','good'],['MT5 bridge','Connected','good'],['MT4 bridge','Connected','good'],['cTrader bridge','Connected','good'],['Trade sync','Active','good'],['Last heartbeat','12 sec ago','good']].map(x=><div class="list-row"><span>{x[0]}</span><b class={x[2]}>{x[1]}</b></div>)}</article></div>
<article class="app-card" id="followers" style="margin-top:10px"><div class="card-head"><div><h2>Follower Accounts</h2><p>Only the Master and platform owner/admin can manage these connected accounts.</p></div><button class="control primary" data-add-account>＋ Add Account</button></div><div class="table-wrap"><table class="app-table"><thead><tr><th>Nickname</th><th>Broker</th><th>Platform</th><th>Environment</th><th>Copy Status</th><th>Risk Multiplier</th><th>Open Trades</th><th>Last Sync</th><th>Actions</th></tr></thead><tbody data-followers></tbody></table></div></article>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="rules"><div class="card-head"><h2>Default Copy Rules</h2><button class="control" data-save-rules>Save</button></div><div class="field"><label>Lot sizing mode</label><select data-rule><option>Risk multiplier</option><option>Fixed lot</option><option>Equity proportional</option></select></div><div class="field"><label>Default multiplier</label><input type="number" value="1.00" step="0.1"></div><div class="field"><label>Copy pending orders</label><select><option>Yes</option><option>No</option></select></div><div class="field"><label>Copy SL / TP changes</label><select><option>Yes</option><option>No</option></select></div></article><article class="app-card" id="risk"><div class="card-head"><h2>Master Risk Guardrails</h2><span class="tag good">Enabled</span></div>{[['Follower Max DD','15%'],['Per-trade max risk','2%'],['Daily loss stop','5%'],['Max open positions','12'],['Max symbol exposure','30%']].map(x=><div class="list-row"><span>{x[0]}</span><b>{x[1]}</b></div>)}<button class="control" data-risk>Edit Risk Controls</button></article><article class="app-card"><h2>Quick Controls</h2><div class="quick-grid"><button data-global="resume">Resume All</button><button data-global="pause">Pause All</button><button data-global="close">Stop New Copies</button><button data-sync>Force Sync</button><button data-report>Generate Report</button><button data-health-check>Run Health Check</button></div><p data-control-status></p></article></div>
<article class="app-card" id="trades" style="margin-top:10px"><div class="card-head"><h2>Live Copied Trades</h2><span class="tag">Master orders mirrored to authorized followers</span></div><div class="table-wrap"><table class="app-table"><thead><tr><th>Symbol</th><th>Side</th><th>Master Lot</th><th>Followers</th><th>Entry</th><th>Current</th><th>Status</th><th>Copy Health</th></tr></thead><tbody><tr><td>XAUUSD</td><td><span class="tag good">BUY</span></td><td>0.50</td><td>7 / 7</td><td>2614.20</td><td>2623.10</td><td><span class="tag good">Open</span></td><td class="good">Healthy</td></tr><tr><td>EURUSD</td><td><span class="tag bad">SELL</span></td><td>0.20</td><td>7 / 7</td><td>1.1024</td><td>1.1001</td><td><span class="tag good">Open</span></td><td class="good">Healthy</td></tr><tr><td>NAS100</td><td><span class="tag good">BUY</span></td><td>0.10</td><td>6 / 7</td><td>20415</td><td>20512</td><td><span class="tag">Open</span></td><td class="bad">1 delayed</td></tr></tbody></table></div></article>
<div class="grid-3" style="margin-top:10px"><article class="app-card" id="history"><h2>Recent Activity</h2>{['Master opened XAUUSD BUY · copied to 7 accounts','Follower “Challenge B” paused by Master','Risk multiplier changed on “Growth 02”','New follower account connected','Connection recovered automatically'].map((x,i)=><div class="list-row"><div><b>{x}</b><small>{i===0?'2 min ago':`${i+1}h ago`}</small></div></div>)}</article><article class="app-card" id="reports"><h2>Reports</h2><div class="quick-grid"><button data-report>Daily Copy Report</button><button data-report>Account Health CSV</button><button data-report>Execution Audit</button><button data-report>Risk Summary</button></div></article><article class="app-card"><h2>Access & Capacity</h2><div class="list-row"><span>Master status</span><b class="good">Active</b></div><div class="list-row"><span>Assigned capacity</span><b>20 followers</b></div><div class="list-row"><span>Used</span><b>8</b></div><div class="progress"><i style="width:40%"></i></div><p>Capacity and Master access are controlled by the platform owner/admin, not by follower accounts.</p></article></div>
<div class="modal" data-account-modal><div class="modal-card"><div class="card-head"><h2>Add Follower Account</h2><button class="control" data-account-close>×</button></div><p>Follower credentials are handled by the secure copy service and are never displayed in the dashboard.</p><div class="field"><label>Account nickname</label><input data-new-nick placeholder="e.g. Challenge C"></div><div class="field"><label>Broker</label><input data-new-broker placeholder="Broker name"></div><div class="field"><label>Platform</label><select data-new-platform><option>MT5</option><option>MT4</option><option>cTrader</option></select></div><div class="field"><label>Environment</label><select data-new-env><option>Demo</option><option>Live</option></select></div><button class="control primary" data-account-save>Add Account</button></div></div>
<script is:inline>
const seed=[{nick:'Growth 01',broker:'Exness',platform:'MT5',env:'Live',status:'Copying',risk:'1.00×',open:3,sync:'20 sec'},{nick:'Challenge A',broker:'IC Markets',platform:'MT5',env:'Live',status:'Copying',risk:'0.75×',open:2,sync:'18 sec'},{nick:'Strategy Test',broker:'Pepperstone',platform:'cTrader',env:'Demo',status:'Copying',risk:'0.50×',open:2,sync:'25 sec'},{nick:'Challenge B',broker:'FP Markets',platform:'MT4',env:'Live',status:'Paused',risk:'0.80×',open:0,sync:'2 min'}];let accounts=JSON.parse(localStorage.getItem('ta-copy-accounts')||'null')||seed;const tbody=document.querySelector('[data-followers]');function render(){tbody.innerHTML=accounts.map((a,i)=>`<tr><td><b>${a.nick}</b></td><td>${a.broker}</td><td><span class="tag">${a.platform}</span></td><td>${a.env}</td><td><span class="tag ${a.status==='Copying'?'good':''}">${a.status}</span></td><td>${a.risk}</td><td>${a.open}</td><td>${a.sync}</td><td><button class="control" data-toggle="${i}">${a.status==='Copying'?'Pause':'Resume'}</button></td></tr>`).join('');tbody.querySelectorAll('[data-toggle]').forEach(b=>b.onclick=()=>{const a=accounts[+b.dataset.toggle];a.status=a.status==='Copying'?'Paused':'Copying';localStorage.setItem('ta-copy-accounts',JSON.stringify(accounts));render()})}document.querySelectorAll('[data-add-account]').forEach(b=>b.onclick=()=>document.querySelector('[data-account-modal]').classList.add('open'));document.querySelector('[data-account-close]')?.addEventListener('click',()=>document.querySelector('[data-account-modal]').classList.remove('open'));document.querySelector('[data-account-save]')?.addEventListener('click',()=>{accounts.push({nick:document.querySelector('[data-new-nick]').value||'New Account',broker:document.querySelector('[data-new-broker]').value||'Broker',platform:document.querySelector('[data-new-platform]').value,env:document.querySelector('[data-new-env]').value,status:'Paused',risk:'1.00×',open:0,sync:'Not synced'});localStorage.setItem('ta-copy-accounts',JSON.stringify(accounts));document.querySelector('[data-account-modal]').classList.remove('open');render()});document.querySelectorAll('[data-sync]').forEach(b=>b.onclick=()=>{b.textContent='✓ Synced'});document.querySelectorAll('[data-global]').forEach(b=>b.onclick=()=>{const mode=b.dataset.global;accounts.forEach(a=>a.status=mode==='resume'?'Copying':'Paused');localStorage.setItem('ta-copy-accounts',JSON.stringify(accounts));render();document.querySelector('[data-control-status]').textContent=mode==='resume'?'All eligible accounts resumed.':'Copying paused in preview.'});document.querySelectorAll('[data-report]').forEach(b=>b.onclick=()=>{const blob=new Blob(['Trade Avata Copy Trading demo report'],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='copy-trading-demo-report.txt';a.click()});document.querySelector('[data-save-rules]')?.addEventListener('click',e=>e.currentTarget.textContent='✓ Saved');document.querySelector('[data-risk]')?.addEventListener('click',()=>alert('Risk control editor opened.'));document.querySelector('[data-health-check]')?.addEventListener('click',e=>e.currentTarget.textContent='✓ Healthy');render();
</script></AppLayout>
