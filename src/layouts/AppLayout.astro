---
import '../styles/app.css';
const {title='Trade Avata',section='Dashboard',nav=[],profile='Temisi'}=Astro.props;const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<!doctype html><html lang="en" data-app-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><link rel="icon" href={`${b}brand/trade-avata-logo.svg`}></head><body><div class="app-shell"><aside class="app-sidebar" data-app-sidebar><a class="app-brand" href={b}><img src={`${b}brand/trade-avata-logo.svg`} alt=""><span>TRADE AVATA<small>{section}</small></span></a><nav class="app-nav">{nav.map(item=>item.group?<div class="group">{item.group}</div>:<a href={item.href} class={item.active?'active':''}><b>{item.icon||'•'}</b><span>{item.label}</span></a>)}</nav></aside><main class="app-main"><header class="app-topbar"><div class="app-topbar-left"><button class="control mobile-menu" data-app-menu>☰</button><slot name="top-left"/></div><div class="app-topbar-right"><slot name="top-right"/><button class="control hide-phone" data-app-customize>⚙ Customize</button><span class="control">{profile}</span></div></header><div class="app-content"><slot/></div></main></div><aside class="settings-panel" data-settings><h3 style="margin:0 0 10px">Appearance</h3><label class="field"><label>Theme</label><select data-app-theme-select><option value="dark">Dark</option><option value="light">Light</option></select></label><label class="field"><label>Density</label><select data-density><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></label><label class="field"><label>Accent</label><div class="color-row"><button class="color-dot" data-accent="#1488ff" style="background:#1488ff"></button><button class="color-dot" data-accent="#8b6bff" style="background:#8b6bff"></button><button class="color-dot" data-accent="#21c991" style="background:#21c991"></button><button class="color-dot" data-accent="#f0b95f" style="background:#f0b95f"></button></div></label><button class="control" data-reset-layout>Reset to default</button></aside><script is:inline>const s=document.querySelector('[data-app-sidebar]');document.querySelector('[data-app-menu]')?.addEventListener('click',()=>s.classList.toggle('open'));document.querySelector('[data-app-customize]')?.addEventListener('click',()=>document.querySelector('[data-settings]').classList.toggle('open'));const themeSelect=document.querySelector('[data-app-theme-select]');const densitySelect=document.querySelector('[data-density]');const savedTheme=localStorage.getItem('ta-app-theme')||'dark';const savedDensity=localStorage.getItem('ta-app-density')||'comfortable';document.documentElement.dataset.appTheme=savedTheme;document.body.dataset.density=savedDensity;if(themeSelect){themeSelect.value=savedTheme;themeSelect.addEventListener('change',()=>{document.documentElement.dataset.appTheme=themeSelect.value;localStorage.setItem('ta-app-theme',themeSelect.value)})}if(densitySelect){densitySelect.value=savedDensity;densitySelect.addEventListener('change',()=>{document.body.dataset.density=densitySelect.value;localStorage.setItem('ta-app-density',densitySelect.value)})}document.querySelectorAll('[data-app-theme-toggle]').forEach(b=>b.addEventListener('click',()=>{const n=document.documentElement.dataset.appTheme==='dark'?'light':'dark';document.documentElement.dataset.appTheme=n;localStorage.setItem('ta-app-theme',n);if(themeSelect)themeSelect.value=n}));document.querySelectorAll('[data-accent]').forEach(b=>b.addEventListener('click',()=>{document.documentElement.style.setProperty('--app-blue',b.dataset.accent);localStorage.setItem('ta-accent',b.dataset.accent)}));const saved=localStorage.getItem('ta-accent');if(saved)document.documentElement.style.setProperty('--app-blue',saved);document.querySelector('[data-reset-layout]')?.addEventListener('click',()=>{['ta-accent','ta-app-theme','ta-app-density'].forEach(k=>localStorage.removeItem(k));location.reload()});</script></body></html>
