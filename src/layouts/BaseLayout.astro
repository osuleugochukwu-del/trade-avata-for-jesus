---
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import SupportChat from '../components/SupportChat.astro';import '../styles/site.css';
const {title='Trade Avata — Trade Simple.',description='Trading tools, learning and intelligent review in one workspace.'}=Astro.props;const b=(import.meta.env.BASE_URL||'/').replace(/\/?$/,'/');
---
<!doctype html><html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><title>{title}</title><link rel="icon" href={`${b}brand/trade-avata-logo.svg`}><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('ta-public-theme')||'light'}catch{}</script></head><body><Header/><main><slot/></main><Footer/><SupportChat/><script is:inline>document.querySelector('[data-menu]')?.addEventListener('click',()=>document.querySelector('[data-mobile]')?.classList.toggle('open'));document.querySelector('[data-theme]')?.addEventListener('click',()=>{const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;localStorage.setItem('ta-public-theme',n)});</script></body></html>
