<button class="support-launcher" data-support-open>Chat with us</button><div class="support-panel" data-support-panel hidden><strong>Trade Avata Support</strong><p style="font-size:11px;color:#9fb2c6">Tell us what happened and include any useful details.</p><textarea data-support-text placeholder="Write your message..."></textarea><button class="button" data-support-send>Save message</button><button class="pill" data-support-close style="margin-left:6px">Close</button><div data-support-status style="font-size:10px;color:#7fd6b2;margin-top:8px"></div></div>
<script is:inline>document.querySelector('[data-support-open]')?.addEventListener('click',()=>document.querySelector('[data-support-panel]').hidden=false);document.querySelector('[data-support-close]')?.addEventListener('click',()=>document.querySelector('[data-support-panel]').hidden=true);document.querySelector('[data-support-send]')?.addEventListener('click',()=>{const t=document.querySelector('[data-support-text]');if(!t.value.trim())return;localStorage.setItem('ta-support-draft',t.value);document.querySelector('[data-support-status]').textContent='Message saved.'})</script>
